{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": "./",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "centrifugo",
          "format": "url",
          "env": "CENTRIFUGO_URL"
        }
      ]
    },
    "centrifugo": {
      "root": "docker/centrifugo/",
      "runtime": "container"
    }
  },
  "rewrites": [
    {
      "source": "/connection/(.*)",
      "destination": {
        "service": "centrifugo"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
