# Variables del VPS de producción. Copiar a .env.vps (gitignoreado) y
# completar. Guía: docs/deployment-vps.md.
#
# Generá cada secreto con:  openssl rand -base64 48 | tr -d '/+=' | cut -c1-48
#
# DATABASE_URL, REDIS_URL, VROOM_URL, OSRM_URL y CENTRIFUGO_URL NO van acá:
# docker-compose.prod.yml las arma apuntando a los servicios internos.

# Dominio público (sin https://). Su registro A debe apuntar al VPS antes del
# primer `up`: Caddy pide el certificado al arrancar.
DOMAIN=app.tu-dominio.com

POSTGRES_PASSWORD=CAMBIAR
REDIS_PASSWORD=CAMBIAR

# >=32 caracteres. getSecretKey() rechaza los placeholders y el login da 500.
JWT_SECRET=CAMBIAR

CENTRIFUGO_TOKEN_HMAC_SECRET_KEY=CAMBIAR
CENTRIFUGO_API_KEY=CAMBIAR

# Solo para el primer `db:seed`: crea el ADMIN_SISTEMA, que ve todas las
# empresas del VPS. Mínimo 12 caracteres; el seed se niega a correr sin ella.
SEED_ADMIN_EMAIL=tu-email@tu-dominio.com
SEED_ADMIN_PASSWORD=CAMBIAR

# Vacío = Perú completo (~1,2 GiB de RAM en OSRM). Para limitarlo a Lima:
# OSRM_BBOX=-77.35,-12.55,-76.60,-11.60  — un pedido fuera del bbox no tiene ruta.
OSRM_BBOX=

# Timeouts del cliente HTTP. VROOM_TIMEOUT >= timeout de vroom-express
# (docker/vroom/config.yml: 300000) o se abortan solves que iban a terminar.
VROOM_TIMEOUT=310000
OSRM_TIMEOUT=30000

# Cloudflare R2: evidencias de entrega y uploads.
R2_ACCOUNT_ID=CAMBIAR
R2_ACCESS_KEY_ID=CAMBIAR
R2_SECRET_ACCESS_KEY=CAMBIAR
R2_BUCKET_NAME=CAMBIAR
R2_PUBLIC_URL=https://CAMBIAR

# Backups de Postgres fuera del VPS. Usá un bucket PRIVADO distinto al de
# evidencias y un token con permiso solo sobre él. Sin esto, el dump diario
# queda únicamente en el disco del VPS.
R2_BACKUP_BUCKET=
R2_BACKUP_ACCESS_KEY_ID=
R2_BACKUP_SECRET_ACCESS_KEY=
BACKUP_KEEP_DAYS=14

# OneSignal (push del chat del conductor).
ONESIGNAL_APP_ID=CAMBIAR
ONESIGNAL_REST_API_KEY=CAMBIAR
