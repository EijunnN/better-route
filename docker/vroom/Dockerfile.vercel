# VROOM con la config resuelta en runtime.
#
# `docker/vroom/config.yml` apunta a `host: osrm-backend`, que es el nombre de
# servicio de docker-compose. Ni en Vercel ni en Railway ese host existe y el
# puerto lo asigna la plataforma, así que la config se genera al arrancar.
#
# Dos modos, según cómo llegue la dirección de OSRM:
#
#   OSRM_URL   (Vercel service binding) → se levanta osrm-proxy.js y VROOM
#              habla contra 127.0.0.1. Hace falta porque el binding puede
#              venir en https: y VROOM solo entiende host+puerto por HTTP.
#   OSRM_HOST  (docker-compose, VPS)    → VROOM habla directo, sin proxy.
#
# La imagen base ya trae un entrypoint que copia /conf/config.yml adentro de
# /vroom-express; lo dejamos hacer su trabajo y solo escribimos ese archivo
# antes.
FROM ghcr.io/vroom-project/vroom-docker:v1.14.0

USER root

# La imagen base no trae bundle de CA y Node avisa en cada arranque
# ("Ignoring extra certs from /etc/ssl/certs/ca-certificates.crt"). Sin esto
# no hay TLS válido hacia ningún destino https.
RUN apt-get update  && apt-get install -y --no-install-recommends ca-certificates  && update-ca-certificates  && rm -rf /var/lib/apt/lists/*

COPY osrm-proxy.js /usr/local/bin/osrm-proxy.js

# maxlocations debe ser <= --max-table-size de OSRM (5000): si OSRM rechaza la
# tabla, VROOM devuelve code 3 y la corrida entera falla, no degrada.
ENV OSRM_HOST=osrm \
    OSRM_PORT=5000 \
    OSRM_PROXY_PORT=5000 \
    PORT=3000 \
    VROOM_THREADS=4 \
    VROOM_MAXLOCATIONS=5000 \
    VROOM_MAXVEHICLES=200 \
    VROOM_TIMEOUT_MS=300000 \
    VROOM_ROUTER=osrm \
    VROOM_LOG=/conf

# Ojo con el escapado: cada `\$` deja la variable SIN expandir en build para
# que la resuelva el heredoc al arrancar. Un `$` pelado acá congelaría los
# defaults de arriba dentro de la imagen, ignorando lo que configure la
# plataforma.
RUN printf '%s\n' \
  '#!/usr/bin/env bash' \
  'set -e' \
  'mkdir -p /conf' \
  'if [ -n "${OSRM_URL:-}" ]; then' \
  '  node /usr/local/bin/osrm-proxy.js &' \
  '  ROUTER_HOST=127.0.0.1' \
  '  ROUTER_PORT=${OSRM_PROXY_PORT}' \
  'else' \
  '  ROUTER_HOST=${OSRM_HOST}' \
  '  ROUTER_PORT=${OSRM_PORT}' \
  'fi' \
  'cat > /conf/config.yml <<EOF' \
  'cliArgs:' \
  '  geometry: true' \
  '  planmode: false' \
  '  threads: ${VROOM_THREADS}' \
  '  explore: 5' \
  "  limit: '10mb'" \
  "  logdir: '/..'" \
  "  logsize: '100M'" \
  '  maxlocations: ${VROOM_MAXLOCATIONS}' \
  '  maxvehicles: ${VROOM_MAXVEHICLES}' \
  '  override: true' \
  "  path: ''" \
  '  port: ${PORT}' \
  "  router: '\${VROOM_ROUTER}'" \
  '  timeout: ${VROOM_TIMEOUT_MS}' \
  "  baseurl: '/'" \
  'routingServers:' \
  '  osrm:' \
  '    car:' \
  "      host: '\${ROUTER_HOST}'" \
  "      port: '\${ROUTER_PORT}'" \
  'EOF' \
  'echo "[vroom] router=${VROOM_ROUTER} osrm=${ROUTER_HOST}:${ROUTER_PORT} port=${PORT} threads=${VROOM_THREADS}"' \
  'exec /bin/bash /docker-entrypoint.sh' \
  > /usr/local/bin/railway-entrypoint.sh \
 && chmod +x /usr/local/bin/railway-entrypoint.sh

EXPOSE 3000

ENTRYPOINT ["/usr/local/bin/railway-entrypoint.sh"]
